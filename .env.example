SESSION_SECRET=replace-with-a-long-random-string
# Neon: project Dashboard > Connect > turn ON "Connection pooling" > copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon Object Storage (bucket "files"): see README
NEON_S3_ENDPOINT=https://BRANCH.storage.c-2.us-east-2.aws.neon.tech
NEON_S3_REGION=us-east-2
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
# Staff who can open /admin to download print files (comma-separated sign-in emails)
ADMIN_EMAILS=
# Stripe card payments (test keys start with sk_test_). Webhook secret: see README.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

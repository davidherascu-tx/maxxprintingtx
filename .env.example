SESSION_SECRET=replace-with-a-long-random-string
# Set automatically by the Neon integration on Vercel
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set automatically when a Blob store is connected on Vercel
BLOB_READ_WRITE_TOKEN=
# Staff who can open /admin to download print files (comma-separated sign-in emails)
ADMIN_EMAILS=
# Stripe card payments (test keys start with sk_test_). Webhook secret: see README.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
